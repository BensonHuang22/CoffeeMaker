# Gems needed to build the documentation site with Jekyll.
# Used by .github/workflows/jekyll-gh-pages.yml, and by `bundle exec jekyll serve`
# if you want to preview the site locally.

source "https://rubygems.org"

# The same gem GitHub Pages runs itself.  It pins a known-good Jekyll version
# and brings the plugins this repository depends on - in particular
# jekyll-optional-front-matter, which is what lets our Markdown files render
# without a YAML front matter block at the top of every one of them.
gem "github-pages", group: :jekyll_plugins

# Dropped from Ruby's standard library, still needed by Jekyll.
gem "webrick", "~> 1.9"
