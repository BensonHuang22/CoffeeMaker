# CoffeeMaker backend configuration overrides.
#
# Copy this file to `.env` in this same folder and edit whatever differs on your
# machine:
#
#     macOS / Linux:       cp .env.template .env
#     Windows PowerShell:  Copy-Item .env.template .env
#
# `.env` is gitignored, so what you put there stays on your machine.  Every
# setting below is optional - anything left commented out falls back to the
# default in application.properties, which is a local MySQL running as root with
# no password.
#
# Spring reads this as a Java properties file, not as a shell script, so:
#   * do NOT quote values.  MYSQL_HOST="localhost" sets the host to "localhost"
#     including the quotes, and the connection fails.
#   * `#` starts a comment and `\` is an escape character.
#   * do not write `export` in front of a setting.

# Host and port of your MySQL server.
#MYSQL_HOST=localhost
#MYSQL_PORT=3306

# The MySQL account the application connects as.
#MYSQL_USER=root

# The password for that account.  Leave the value empty if it has none.
#MYSQL_PASSWORD=
